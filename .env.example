# ============================================================
#  NyaayaAI – Environment Configuration
#  Copy this file to ".env" and fill in your values.
#  The app works fully in OFFLINE/DEMO mode without any keys.
# ============================================================

# -------------------------------------------------------
# OPTIONAL: Live AI (leave blank to use built-in knowledge base)
# Get a free Gemini key → https://aistudio.google.com/
# Or an OpenAI key     → https://platform.openai.com/
# -------------------------------------------------------
AI_API_KEY=

# Which LLM provider to use when AI_API_KEY is set.
# Options: "gemini"  |  "openai"  |  "auto" (tries Gemini first, then OpenAI)
LLM_PROVIDER=auto

# -------------------------------------------------------
# Backend server settings  (defaults are fine as-is)
# -------------------------------------------------------
PORT=8000
DEBUG=true
